{
  "name": "tanstarter",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "start:e2e": "node --env-file-if-exists=.env.e2e .output/server/index.mjs",
    "test": "vp test",
    "test:e2e": "playwright test --pass-with-no-tests",
    "lint": "vp lint --type-aware --type-check",
    "lint:fix": "vp lint --type-aware --type-check --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "prepare": "vp config",
    "db": "drizzle-kit",
    "deps": "vpx taze@latest -Ilw --maturity-period 3",
    "tanstack": "vpx @tanstack/cli@latest",
    "ui": "vpx shadcn@latest",
    "auth": "vpx auth@latest",
    "auth:secret": "vpx auth@latest secret",
    "auth:generate": "vpx auth@latest generate --config ./src/lib/auth/auth.ts --y --output ./src/lib/db/schema/auth.schema.ts",
    "auth:migrate": "vpr auth:generate && vpr db generate && vpr db migrate",
    "skills": "vpx skills@latest",
    "intent": "vpx @tanstack/intent@latest"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@better-auth/drizzle-adapter": "1.7.1",
    "@fontsource-variable/inter": "5.3.0",
    "@icons-pack/react-simple-icons": "13.15.1",
    "@t3-oss/env-core": "0.13.11",
    "@tanstack/react-query": "5.102.2",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.49",
    "better-auth": "1.7.1",
    "class-variance-authority": "0.7.1",
    "cnfast": "0.1.0",
    "drizzle-orm": "1.0.0-rc.4",
    "lucide-react": "1.34.0",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "4.19.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/devtools-a11y": "0.2.2",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/eslint-plugin-query": "5.102.2",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@tanstack/react-devtools": "0.10.12",
    "@tanstack/react-query-devtools": "5.102.2",
    "@tanstack/react-router-devtools": "1.167.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "drizzle-kit": "1.0.0-rc.4",
    "nitro": "3.0.260610-beta",
    "oxc-transform-react": "0.147.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.23.0",
  "generator": "create-mugnavo",
  "intent": {
    "skills": [
      "@tanstack/*"
    ]
  }
